{
  "name": "@dytsou/resume-converter",
  "version": "3.2.2",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run convert && vite build",
    "convert": "pnpm run convert:latex",
    "convert:latex": "node scripts/modules/latex/convert.mjs",
    "lint": "biome lint .",
    "test": "node --test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "preview": "pnpm run build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "release": "pnpm run convert && pnpm run build && pnpm run publish",
    "publish:npmjs": "pnpm publish --access public --registry https://registry.npmjs.org",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || true",
    "deploy": "pnpm run build && wrangler deploy --config wrangler.worker.toml --env=\"\""
  },
  "dependencies": {
    "@unified-latex/unified-latex-to-hast": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "hast-util-to-html": "^9.0.5",
    "mathjax-full": "^3.2.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dytsou/resume.git"
  },
  "files": [
    "dist",
    "scripts",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
