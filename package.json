{
  "name": "@dytsou/resume-converter",
  "version": "2.4.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:compile": "node scripts/dev-compile-server.mjs",
    "dev:vite": "vite",
    "build": "pnpm run convert && vite build",
    "convert": "node scripts/convert-latex.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "pnpm run build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "release": "pnpm run convert && pnpm run build && pnpm run publish",
    "publish:npmjs": "pnpm publish --access public --registry https://registry.npmjs.org",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || true",
    "deploy": "pnpm run build && node scripts/cf-deploy.mjs --production",
    "deploy:snapshot": "pnpm run build && node scripts/cf-deploy.mjs --snapshot",
    "deploy:ci": "node scripts/cf-deploy.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@uiw/react-codemirror": "^4.25.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "scripts",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
