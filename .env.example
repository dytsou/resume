# Local development: copy config.example.yml to config.yml and fill in your info.
# config.yml is gitignored — never commit your personal info.
# cp config.example.yml config.yml

# Subpath deployment (GitHub Pages or Cloudflare Pages at /resume)
# Cloudflare Pages sets CF_PAGES=1 automatically during builds.
GITHUB_PAGES=true
# BASE_PATH=/resume/
# WORKER_SUBPATH=true  # set by deploy:subpath for dy.tsou.me/resume worker layout

# Cloudflare Pages project name (used by pnpm secrets:set)
# CF_PAGES_PROJECT=your-pages-project
